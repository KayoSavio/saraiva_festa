# String de conexão do Neon (Dashboard > Connection Details, use a versão "pooled")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão do admin (qualquer texto longo e aleatório)
SESSION_SECRET=gere-um-texto-aleatorio-com-32-caracteres-ou-mais

# Aviso no seu WhatsApp a cada pedido (CallMeBot, gratuito).
# 1) Siga o passo a passo em https://www.callmebot.com/blog/free-api-whatsapp-messages/
#    (salvar o contato deles e mandar a mensagem de autorização pelo seu WhatsApp)
# 2) Cole aqui a apikey que chegar de resposta
CALLMEBOT_APIKEY=
# Número que recebe o aviso (com 55 + DDD). Padrão: o do site.
OWNER_WHATSAPP=5524999051196
# Endereço do site publicado, para o aviso trazer o link do painel
SITE_URL=https://seu-site.vercel.app
